@model IEnumerable<MonitorVentas.Models.Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="page-header">
    <div>
        <h1>Clientes</h1>
        <p>Personas registradas que realizan compras.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo cliente</a>
</div>

<form asp-action="Index" method="get" class="mb-3" role="search">
    <div class="input-group">
        <label class="input-group-text" for="buscar">Buscar:</label>
        <input type="search" name="buscar" id="buscar" value="@ViewData["Buscar"]" class="form-control"
               placeholder="Nombre, teléfono o dirección..." autocomplete="off"
               data-filtrar="#tabla" data-contador="#contador" data-entidad="clientes" />
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </div>
    <div class="form-text" id="contador"></div>
</form>

<div class="panel panel-flush">
    <div class="table-responsive">
        <table class="table table-hover align-middle" id="tabla">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>@Html.DisplayNameFor(m => m.Nombre)</th>
                    <th>@Html.DisplayNameFor(m => m.Telefono)</th>
                    <th>@Html.DisplayNameFor(m => m.Direccion)</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td class="text-muted">@x.ClienteId</td>
                        <td>@x.Nombre</td>
                        <td>@x.Telefono</td>
                        <td>@(x.Direccion ?? "—")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@x.ClienteId" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@x.ClienteId" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
                <tr class="fila-vacia @(Model.Any() ? "d-none" : "")">
                    <td colspan="5" class="text-center text-muted py-4">
                        @(ViewData["Buscar"] != null ? "No hay clientes que coincidan con la búsqueda." : "Todavía no hay clientes registrados.")
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
