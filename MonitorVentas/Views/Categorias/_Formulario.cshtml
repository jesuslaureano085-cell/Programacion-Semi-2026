@model MonitorVentas.Models.Categoria

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="mb-3">
    <label asp-for="Nombre" class="form-label req"></label>
    <input asp-for="Nombre" class="form-control" placeholder="Ej.: Panadería" autocomplete="off" autofocus />
    <span asp-validation-for="Nombre" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Qué tipo de productos incluye"></textarea>
    <span asp-validation-for="Descripcion" class="text-danger small"></span>
</div>
