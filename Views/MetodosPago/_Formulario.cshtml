@model MonitorVentas.Models.MetodoPago

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="mb-3">
    <label asp-for="Nombre" class="form-label req"></label>
    <input asp-for="Nombre" class="form-control" placeholder="Ej.: Vale de despensa" autocomplete="off" autofocus />
    <span asp-validation-for="Nombre" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder=""></textarea>
    <span asp-validation-for="Descripcion" class="text-danger small"></span>
</div>
<div class="mb-3 form-check">
    <input asp-for="Activo" class="form-check-input" />
    <label asp-for="Activo" class="form-check-label"></label>
    <div class="form-text">Si lo desmarcas, no aparecerá como opción al registrar ventas.</div>
</div>
