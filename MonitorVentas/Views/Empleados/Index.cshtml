@model IEnumerable<MonitorVentas.Models.Empleado>
@{
    ViewData["Title"] = "Empleados";
}

<div class="page-header">
    <div>
        <h1>Empleados</h1>
        <p>Personal del supermercado: cajeros, supervisores, bodegueros y gerentes.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo empleado</a>
</div>

<form asp-action="Index" method="get" class="mb-3" role="search">
    <div class="input-group">
        <label class="input-group-text" for="buscar">Buscar:</label>
        <input type="search" name="buscar" id="buscar" value="@ViewData["Buscar"]" class="form-control"
               placeholder="Nombre, DUI, cargo o teléfono..." autocomplete="off"
               data-filtrar="#tabla" data-contador="#contador" data-entidad="empleados" />
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </div>
    <div class="form-text" id="contador"></div>
</form>

<div class="panel panel-flush">
    <div class="table-responsive">
        <table class="table table-hover align-middle" id="tabla">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>@Html.DisplayNameFor(m => m.Nombre)</th>
                    <th>@Html.DisplayNameFor(m => m.Dui)</th>
                    <th>@Html.DisplayNameFor(m => m.Cargo)</th>
                    <th>@Html.DisplayNameFor(m => m.Telefono)</th>
                    <th>@Html.DisplayNameFor(m => m.FechaIngreso)</th>
                    <th>@Html.DisplayNameFor(m => m.Activo)</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td class="text-muted">@x.EmpleadoId</td>
                        <td>@x.Nombre</td>
                        <td><span class="mono">@x.Dui</span></td>
                        <td>@x.Cargo</td>
                        <td>@(x.Telefono ?? "—")</td>
                        <td>@x.FechaIngreso.ToString("dd/MM/yyyy")</td>
                        <td><span class="estado @(x.Activo ? "si" : "no")">@(x.Activo ? "Activo" : "Inactivo")</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@x.EmpleadoId" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@x.EmpleadoId" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
                <tr class="fila-vacia @(Model.Any() ? "d-none" : "")">
                    <td colspan="8" class="text-center text-muted py-4">
                        @(ViewData["Buscar"] != null ? "No hay empleados que coincidan con la búsqueda." : "Todavía no hay empleados registrados.")
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
