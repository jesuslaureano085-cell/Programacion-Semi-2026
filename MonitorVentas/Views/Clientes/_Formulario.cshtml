@model MonitorVentas.Models.Cliente

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="mb-3">
    <label asp-for="Nombre" class="form-label req"></label>
    <input asp-for="Nombre" class="form-control" autocomplete="off" autofocus />
    <span asp-validation-for="Nombre" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="Telefono" class="form-label req"></label>
    <input asp-for="Telefono" class="form-control" placeholder="Ej.: 7000-0000" autocomplete="off" />
    <span asp-validation-for="Telefono" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="Direccion" class="form-label"></label>
    <input asp-for="Direccion" class="form-control" autocomplete="off" />
    <span asp-validation-for="Direccion" class="text-danger small"></span>
</div>
