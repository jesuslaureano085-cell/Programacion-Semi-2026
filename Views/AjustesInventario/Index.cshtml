@model IEnumerable<MonitorVentas.Models.AjusteInventario>
@{
    ViewData["Title"] = "Ajustes de inventario";
    var tipo = ViewData["Tipo"] as string;
}

<div class="page-header">
    <div>
        <h1>Ajustes de inventario</h1>
        <p>Entradas y salidas de mercadería que no son ventas. Cada ajuste mueve el stock del producto.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo ajuste</a>
</div>

<form asp-action="Index" method="get" class="mb-3" role="search">
    <div class="input-group">
        <label class="input-group-text" for="buscar">Buscar:</label>
        <input type="search" name="buscar" id="buscar" value="@ViewData["Buscar"]" class="form-control"
               placeholder="Producto, motivo, responsable u observación..." autocomplete="off"
               data-filtrar="#tabla" data-contador="#contador" data-entidad="ajustes" />
        <label class="input-group-text" for="tipo">Tipo:</label>
        <select name="tipo" id="tipo" class="form-select" style="max-width: 150px" onchange="this.form.submit()">
            <option value="">(Todos)</option>
            <option value="Entrada" selected="@(tipo == "Entrada")">Entradas</option>
            <option value="Salida" selected="@(tipo == "Salida")">Salidas</option>
        </select>
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </div>
    <div class="form-text" id="contador"></div>
</form>

<div class="panel panel-flush">
    <div class="table-responsive">
        <table class="table table-hover align-middle" id="tabla">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>@Html.DisplayNameFor(m => m.Producto)</th>
                    <th>@Html.DisplayNameFor(m => m.Tipo)</th>
                    <th class="text-end">@Html.DisplayNameFor(m => m.Cantidad)</th>
                    <th>@Html.DisplayNameFor(m => m.Motivo)</th>
                    <th>@Html.DisplayNameFor(m => m.Empleado)</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td class="text-nowrap">@x.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@x.Producto?.Nombre</td>
                        <td><span class="movimiento @(x.Tipo == "Entrada" ? "entrada" : "salida")">@(x.Tipo == "Entrada" ? "+ Entrada" : "− Salida")</span></td>
                        <td class="text-end">@x.Cantidad</td>
                        <td>
                            @x.Motivo
                            @if (x.Observacion != null)
                            {
                                <div class="form-text m-0">@x.Observacion</div>
                            }
                        </td>
                        <td>@x.Empleado?.Nombre</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@x.AjusteInventarioId" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@x.AjusteInventarioId" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
                <tr class="fila-vacia @(Model.Any() ? "d-none" : "")">
                    <td colspan="7" class="text-center text-muted py-4">
                        @(ViewData["Buscar"] != null || tipo != null ? "No hay ajustes que coincidan con la búsqueda." : "Todavía no hay ajustes registrados.")
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
