<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Monitor</title>
    <script>
        // Si esta página se abre dentro de una ventana del escritorio,
        // se oculta la barra superior (la ventana ya tiene la suya).
        if (window.self !== window.top) document.documentElement.classList.add('en-ventana');
    </script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MonitorVentas.styles.css" asp-append-version="true" />
</head>
<body class="modulo" data-cambio="@(TempData.Peek("Exito") != null ? "1" : null)">
    <header class="barra-sola">
        <partial name="_LogoMini" />
        <span>Monitor — @ViewData["Title"]</span>
        <a class="btn btn-sm" asp-controller="Home" asp-action="Index">Ir al escritorio</a>
    </header>

    <main role="main" class="modulo-contenido">
        @if (TempData["Exito"] is string exito)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @exito
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
