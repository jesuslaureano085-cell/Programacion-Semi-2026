@model IEnumerable<MonitorVentas.Models.Promocion>
@{
    ViewData["Title"] = "Promociones";
    var estado = ViewData["Estado"] as string;
}

<div class="page-header">
    <div>
        <h1>Promociones</h1>
        <p>Descuentos por fechas. La caja aplica sola el mejor descuento vigente de cada producto.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Nueva promoción</a>
</div>

<form asp-action="Index" method="get" class="mb-3" role="search">
    <div class="input-group">
        <label class="input-group-text" for="buscar">Buscar:</label>
        <input type="search" name="buscar" id="buscar" value="@ViewData["Buscar"]" class="form-control"
               placeholder="Nombre, producto o categoría..." autocomplete="off"
               data-filtrar="#tabla" data-contador="#contador" data-entidad="promociones" />
        <label class="input-group-text" for="estado">Estado:</label>
        <select name="estado" id="estado" class="form-select" style="max-width: 160px" onchange="this.form.submit()">
            <option value="">(Todas)</option>
            <option value="Vigente" selected="@(estado == "Vigente")">Vigentes</option>
            <option value="Programada" selected="@(estado == "Programada")">Programadas</option>
            <option value="Vencida" selected="@(estado == "Vencida")">Vencidas</option>
            <option value="Inactiva" selected="@(estado == "Inactiva")">Inactivas</option>
        </select>
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </div>
    <div class="form-text" id="contador"></div>
</form>

<div class="panel panel-flush">
    <div class="table-responsive">
        <table class="table table-hover align-middle" id="tabla">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(m => m.Nombre)</th>
                    <th>@Html.DisplayNameFor(m => m.Alcance)</th>
                    <th class="text-end">Descuento</th>
                    <th>Vigencia</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.Nombre</td>
                        <td>@(x.Producto != null ? "Producto: " + x.Producto.Nombre : "Categoría: " + x.Categoria?.Nombre)</td>
                        <td class="text-end"><span class="descuento">-@x.Porcentaje%</span></td>
                        <td class="text-nowrap">@x.FechaInicio.ToString("dd/MM/yyyy") – @x.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td><span class="estado promo-@x.Estado.ToLower()">@x.Estado</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@x.PromocionId" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@x.PromocionId" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
                <tr class="fila-vacia @(Model.Any() ? "d-none" : "")">
                    <td colspan="6" class="text-center text-muted py-4">
                        @(ViewData["Buscar"] != null || estado != null ? "No hay promociones que coincidan con la búsqueda." : "Todavía no hay promociones registradas.")
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
