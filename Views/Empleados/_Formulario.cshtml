@model MonitorVentas.Models.Empleado

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="mb-3">
    <label asp-for="Nombre" class="form-label req"></label>
    <input asp-for="Nombre" class="form-control" autocomplete="off" autofocus />
    <span asp-validation-for="Nombre" class="text-danger small"></span>
</div>
<div class="row">
<div class="col-md-6">
<div class="mb-3">
    <label asp-for="Dui" class="form-label req"></label>
    <input asp-for="Dui" class="form-control" placeholder="00000000-0" autocomplete="off" maxlength="10" inputmode="numeric" data-formato="dui" />
    <span asp-validation-for="Dui" class="text-danger small"></span>
</div>
</div>
<div class="col-md-6">
<div class="mb-3">
    <label asp-for="Cargo" class="form-label req"></label>
    <select asp-for="Cargo" class="form-select" asp-items="@(new SelectList(Empleado.Cargos))">
        <option value="">-- Seleccione --</option>
    </select>
    <span asp-validation-for="Cargo" class="text-danger small"></span>
</div>
</div>
</div>
<div class="row">
<div class="col-md-6">
<div class="mb-3">
    <label asp-for="Telefono" class="form-label"></label>
    <input asp-for="Telefono" class="form-control" placeholder="Ej.: 7000-0000" autocomplete="off" />
    <span asp-validation-for="Telefono" class="text-danger small"></span>
</div>
</div>
<div class="col-md-6">
<div class="mb-3">
    <label asp-for="FechaIngreso" class="form-label req"></label>
    <input asp-for="FechaIngreso" class="form-control" type="date" autocomplete="off" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
    <span asp-validation-for="FechaIngreso" class="text-danger small"></span>
</div>
</div>
</div>
<div class="mb-3 form-check">
    <input asp-for="Activo" class="form-check-input" />
    <label asp-for="Activo" class="form-check-label"></label>
    <div class="form-text">Desmárcalo si el empleado ya no trabaja aquí (se conserva su historial).</div>
</div>
