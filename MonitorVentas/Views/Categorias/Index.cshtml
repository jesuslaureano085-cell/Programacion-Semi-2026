@model IEnumerable<MonitorVentas.Models.Categoria>
@{
    ViewData["Title"] = "Categorías";
}

<div class="page-header">
    <div>
        <h1>Categorías</h1>
        <p>Grupos en los que se organizan los productos.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Nueva categoría</a>
</div>

<form asp-action="Index" method="get" class="mb-3" role="search">
    <div class="input-group">
        <label class="input-group-text" for="buscar">Buscar:</label>
        <input type="search" name="buscar" id="buscar" value="@ViewData["Buscar"]" class="form-control"
               placeholder="Nombre o descripción..." autocomplete="off"
               data-filtrar="#tabla" data-contador="#contador" data-entidad="categorías" />
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </div>
    <div class="form-text" id="contador"></div>
</form>

<div class="panel panel-flush">
    <div class="table-responsive">
        <table class="table table-hover align-middle" id="tabla">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>@Html.DisplayNameFor(m => m.Nombre)</th>
                    <th>@Html.DisplayNameFor(m => m.Descripcion)</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td class="text-muted">@x.CategoriaId</td>
                        <td>@x.Nombre</td>
                        <td>@(x.Descripcion ?? "—")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@x.CategoriaId" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@x.CategoriaId" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
                <tr class="fila-vacia @(Model.Any() ? "d-none" : "")">
                    <td colspan="4" class="text-center text-muted py-4">
                        @(ViewData["Buscar"] != null ? "No hay categorías que coincidan con la búsqueda." : "Todavía no hay categorías registradas.")
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
