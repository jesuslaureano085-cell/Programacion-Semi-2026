@model MonitorVentas.Models.Promocion

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row">
    <div class="col-md-8">
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label req"></label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej.: Semana de los lácteos" autocomplete="off" autofocus />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="Porcentaje" class="form-label req"></label>
            <div class="input-group">
                <input asp-for="Porcentaje" class="form-control" type="number" min="1" max="90" step="1" />
                <span class="input-group-text">%</span>
            </div>
            <span asp-validation-for="Porcentaje" class="text-danger small"></span>
        </div>
    </div>
</div>

<fieldset class="mb-3">
    <legend class="form-label req" style="font-size: 13px">Aplica a</legend>
    <div class="d-flex gap-4 mb-2">
        <label class="form-check">
            <input type="radio" asp-for="Alcance" value="producto" class="form-check-input" data-alcance /> <span class="form-check-label">Un producto</span>
        </label>
        <label class="form-check">
            <input type="radio" asp-for="Alcance" value="categoria" class="form-check-input" data-alcance /> <span class="form-check-label">Toda una categoría</span>
        </label>
    </div>
    <div class="row">
        <div class="col-md-6" id="campo-producto">
            <select asp-for="ProductoId" class="form-select" asp-items="@(ViewData["Productos"] as SelectList)" aria-label="Producto">
                <option value="">-- Seleccione el producto --</option>
            </select>
            <span asp-validation-for="ProductoId" class="text-danger small"></span>
        </div>
        <div class="col-md-6" id="campo-categoria">
            <select asp-for="CategoriaId" class="form-select" asp-items="@(ViewData["Categorias"] as SelectList)" aria-label="Categoría">
                <option value="">-- Seleccione la categoría --</option>
            </select>
            <span asp-validation-for="CategoriaId" class="text-danger small"></span>
        </div>
    </div>
</fieldset>

<div class="row">
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="FechaInicio" class="form-label req"></label>
            <input asp-for="FechaInicio" class="form-control" type="date" />
            <span asp-validation-for="FechaInicio" class="text-danger small"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="FechaFin" class="form-label req"></label>
            <input asp-for="FechaFin" class="form-control" type="date" />
            <span asp-validation-for="FechaFin" class="text-danger small"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3 form-check pt-md-4">
            <input asp-for="Activa" class="form-check-input" />
            <label asp-for="Activa" class="form-check-label"></label>
        </div>
    </div>
</div>

<script>
    // Muestra solo la lista que corresponde a "Aplica a"
    (function () {
        const radios = document.querySelectorAll('input[data-alcance]');
        function actualizar() {
            const valor = document.querySelector('input[data-alcance]:checked')?.value || 'producto';
            const prod = document.getElementById('campo-producto');
            const cat = document.getElementById('campo-categoria');
            prod.classList.toggle('apagado', valor !== 'producto');
            cat.classList.toggle('apagado', valor !== 'categoria');
            prod.querySelector('select').disabled = valor !== 'producto';
            cat.querySelector('select').disabled = valor !== 'categoria';
        }
        radios.forEach(r => r.addEventListener('change', actualizar));
        actualizar();
    })();
</script>
