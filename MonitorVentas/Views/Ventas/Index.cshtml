@model IEnumerable<MonitorVentas.Models.VentaResumen>
@{
    ViewData["Title"] = "Historial de ventas";
    var periodo = ViewData["Periodo"] as string ?? "todas";
    var validas = Model.Where(v => !v.Anulada).ToList();
}

<div class="page-header">
    <div>
        <h1>Historial de ventas</h1>
        <p>Todas las ventas registradas. Las anuladas no cuentan en los totales.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Nueva venta</a>
</div>

<form asp-action="Index" method="get" class="mb-3" role="search">
    <div class="input-group">
        <label class="input-group-text" for="buscar">Buscar:</label>
        <input type="search" name="buscar" id="buscar" value="@ViewData["Buscar"]" class="form-control"
               placeholder="N.º de venta, cliente, cajero o método..." autocomplete="off"
               data-filtrar="#tabla" data-contador="#contador" data-entidad="ventas" />
        <label class="input-group-text" for="periodo">Período:</label>
        <select name="periodo" id="periodo" class="form-select" style="max-width: 170px" onchange="this.form.submit()">
            <option value="hoy" selected="@(periodo == "hoy")">Hoy</option>
            <option value="semana" selected="@(periodo == "semana")">Últimos 7 días</option>
            <option value="mes" selected="@(periodo == "mes")">Este mes</option>
            <option value="todas" selected="@(periodo == "todas")">Todas</option>
        </select>
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </div>
    <div class="form-text" id="contador"></div>
</form>

<div class="row g-2 mb-3">
    <div class="col-sm-4"><div class="resumen-caja"><span>Ventas</span><b>@validas.Count</b></div></div>
    <div class="col-sm-4"><div class="resumen-caja"><span>Artículos</span><b>@validas.Sum(v => v.Articulos)</b></div></div>
    <div class="col-sm-4"><div class="resumen-caja"><span>Total vendido</span><b>@validas.Sum(v => v.Total).ToString("C")</b></div></div>
</div>

<div class="panel panel-flush">
    <div class="table-responsive">
        <table class="table table-hover align-middle" id="tabla">
            <thead>
                <tr>
                    <th>N.º</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th>Cajero</th>
                    <th>Método</th>
                    <th class="text-end">Artículos</th>
                    <th class="text-end">Total</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr class="@(v.Anulada ? "fila-anulada" : "")">
                        <td class="mono">#@v.VentaId</td>
                        <td>@v.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@v.Cliente</td>
                        <td>@v.Cajero</td>
                        <td>@v.MetodoPago</td>
                        <td class="text-end">@v.Articulos</td>
                        <td class="text-end">@v.Total.ToString("C")</td>
                        <td><span class="estado @(v.Anulada ? "no" : "si")">@(v.Anulada ? "Anulada" : "Válida")</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@v.VentaId" class="btn btn-sm btn-outline-primary">Ver ticket</a>
                        </td>
                    </tr>
                }
                <tr class="fila-vacia @(Model.Any() ? "d-none" : "")">
                    <td colspan="9" class="text-center text-muted py-4">
                        @(ViewData["Buscar"] != null ? "No hay ventas que coincidan con la búsqueda." : "No hay ventas en este período.")
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
