@model MonitorVentas.Models.Empleado
@{
    ViewData["Title"] = "Eliminar empleado";
}

<div class="page-header">
    <div>
        <h1>Eliminar empleado</h1>
        <p>Registro #@Model.EmpleadoId</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 col-xl-7">
        @if (ViewData["Bloqueo"] is string bloqueo)
        {
            <div class="alert alert-warning">@bloqueo</div>
        }
        else
        {
            <div class="alert alert-danger">¿Seguro que deseas eliminar este registro? Esta acción no se puede deshacer. Si el empleado solo dejó de trabajar, es mejor editarlo y desmarcar "Activo".</div>
        }

        <div class="panel">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted fw-normal">@Html.DisplayNameFor(m => m.Nombre)</dt>
                <dd class="col-sm-8">@Model.Nombre</dd>
                <dt class="col-sm-4 text-muted fw-normal">@Html.DisplayNameFor(m => m.Dui)</dt>
                <dd class="col-sm-8">@Model.Dui</dd>
                <dt class="col-sm-4 text-muted fw-normal">@Html.DisplayNameFor(m => m.Cargo)</dt>
                <dd class="col-sm-8">@Model.Cargo</dd>
                <dt class="col-sm-4 text-muted fw-normal">@Html.DisplayNameFor(m => m.Telefono)</dt>
                <dd class="col-sm-8">@(Model.Telefono ?? "—")</dd>
                <dt class="col-sm-4 text-muted fw-normal">@Html.DisplayNameFor(m => m.FechaIngreso)</dt>
                <dd class="col-sm-8">@Model.FechaIngreso.ToString("dd/MM/yyyy")</dd>
                <dt class="col-sm-4 text-muted fw-normal">@Html.DisplayNameFor(m => m.Activo)</dt>
                <dd class="col-sm-8">@(Model.Activo ? "Activo" : "Inactivo")</dd>
            </dl>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.EmpleadoId" method="post" class="d-flex gap-2 mt-3">
            <input type="hidden" asp-for="EmpleadoId" />
            @if (ViewData["Bloqueo"] == null)
            {
                <button type="submit" class="btn btn-danger">Sí, eliminar</button>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </form>
    </div>
</div>
