@model IEnumerable<MonitorVentas.Models.Producto>
@{
    ViewData["Title"] = "Productos";
    var umbral = MonitorVentas.Models.DashboardViewModel.UmbralStockBajo;
}

<div class="page-header">
    <div>
        <h1>Productos</h1>
        <p>Inventario del supermercado. Las filas en rojo tienen @umbral unidades o menos.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo producto</a>
</div>

<form asp-action="Index" method="get" class="mb-3" role="search">
    <div class="input-group">
        <label class="input-group-text" for="buscar">Buscar:</label>
        <input type="search" name="buscar" id="buscar" value="@ViewData["Buscar"]" class="form-control"
               placeholder="Nombre, código, categoría o proveedor..." autocomplete="off"
               data-filtrar="#tabla" data-contador="#contador" data-entidad="productos" />
        <label class="input-group-text" for="categoriaId">Categoría:</label>
        <select name="categoriaId" id="categoriaId" class="form-select" style="max-width: 190px"
                asp-items="@(ViewData["Categorias"] as SelectList)" onchange="this.form.submit()">
            <option value="">(Todas)</option>
        </select>
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </div>
    <div class="form-text" id="contador"></div>
</form>

<div class="panel panel-flush">
    <div class="table-responsive">
        <table class="table table-hover align-middle" id="tabla">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>@Html.DisplayNameFor(m => m.Codigo)</th>
                    <th>@Html.DisplayNameFor(m => m.Nombre)</th>
                    <th>@Html.DisplayNameFor(m => m.Categoria)</th>
                    <th>@Html.DisplayNameFor(m => m.Proveedor)</th>
                    <th class="text-end">@Html.DisplayNameFor(m => m.Precio)</th>
                    <th class="text-end">@Html.DisplayNameFor(m => m.Stock)</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr class="@(x.Stock <= umbral ? "stock-bajo" : "")">
                        <td class="text-muted">@x.ProductoId</td>
                        <td class="mono">@(x.Codigo ?? "—")</td>
                        <td>@x.Nombre</td>
                        <td>@x.Categoria?.Nombre</td>
                        <td>@x.Proveedor?.Nombre</td>
                        <td class="text-end">@x.Precio.ToString("C")</td>
                        <td class="text-end">@x.Stock</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@x.ProductoId" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@x.ProductoId" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
                <tr class="fila-vacia @(Model.Any() ? "d-none" : "")">
                    <td colspan="8" class="text-center text-muted py-4">
                        @(ViewData["Buscar"] != null || ViewData["CategoriaId"] != null ? "No hay productos que coincidan con la búsqueda." : "Todavía no hay productos registrados.")
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
