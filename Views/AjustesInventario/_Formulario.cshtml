@model MonitorVentas.Models.AjusteInventario
@{
    var esEdicion = Model.AjusteInventarioId > 0;
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row">
    <div class="col-md-8">
        <div class="mb-3">
            <label asp-for="ProductoId" class="form-label req"></label>
            @if (esEdicion)
            {
                <input class="form-control" value="@Model.Producto?.Nombre" readonly />
                <div class="form-text">El producto no se cambia. Si se equivocó de producto, elimine este ajuste y cree otro.</div>
            }
            else
            {
                <select asp-for="ProductoId" class="form-select" asp-items="@(ViewData["Productos"] as SelectList)" autofocus>
                    <option value="0">-- Seleccione --</option>
                </select>
                <span asp-validation-for="ProductoId" class="text-danger small"></span>
            }
        </div>
    </div>
    <div class="col-md-4">
        <div class="mb-3">
            <span class="form-label d-block req">Tipo</span>
            <div class="d-flex gap-3 pt-1">
                <label class="form-check">
                    <input type="radio" asp-for="Tipo" value="Entrada" class="form-check-input" /> <span class="form-check-label">Entrada (+)</span>
                </label>
                <label class="form-check">
                    <input type="radio" asp-for="Tipo" value="Salida" class="form-check-input" /> <span class="form-check-label">Salida (−)</span>
                </label>
            </div>
            <span asp-validation-for="Tipo" class="text-danger small"></span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="mb-3">
            <label asp-for="Cantidad" class="form-label req"></label>
            <input asp-for="Cantidad" class="form-control" type="number" min="1" max="100000" step="1" />
            <span asp-validation-for="Cantidad" class="text-danger small"></span>
        </div>
    </div>
    <div class="col-md-8">
        <div class="mb-3">
            <label asp-for="Motivo" class="form-label req"></label>
            <select asp-for="Motivo" class="form-select" asp-items="@(new SelectList(AjusteInventario.Motivos))">
                <option value="">-- Seleccione --</option>
            </select>
            <span asp-validation-for="Motivo" class="text-danger small"></span>
        </div>
    </div>
</div>

<div class="mb-3">
    <label asp-for="EmpleadoId" class="form-label req"></label>
    <select asp-for="EmpleadoId" class="form-select" asp-items="@(ViewData["Empleados"] as SelectList)">
        <option value="0">-- Seleccione --</option>
    </select>
    <span asp-validation-for="EmpleadoId" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Observacion" class="form-label"></label>
    <textarea asp-for="Observacion" class="form-control" rows="2" placeholder="Obligatoria si el motivo es &quot;Otro&quot;"></textarea>
    <span asp-validation-for="Observacion" class="text-danger small"></span>
</div>
